#!/usr/bin/env bash
# haversack - collapse a conda environment into a single squashfs image.
#
# An environment full of small files is expensive on a shared filesystem: it
# burns inode quota and every import is a burst of metadata round-trips.  This
# packs the whole environment into one compressed file and mounts it back at
# its own original path, so nothing inside the environment needs rewriting and
# it behaves exactly as it did before - only faster, and one file instead of
# tens of thousands.
#
# https://github.com/saarantras/haversack
set -euo pipefail

VERSION=0.1.0
PROG=${0##*/}
SELF=$(readlink -f "$0")
# Not $HOSTNAME: bash keeps an inherited value, and Slurm jobs inherit the
# submitting host's.  Records keyed by host must name the node they are on.
HOST=$(uname -n); HOST=${HOST%%.*}

# ---------------------------------------------------------------- discovery --
# squashfuse and mksquashfs are often present only inside an Apptainer or
# Singularity install, which is very common on clusters that ship neither as a
# system package.  Look there before giving up.
_libexec_dirs() {
    local base
    for base in /usr/libexec /usr/local/libexec /opt/apptainer/libexec \
                /usr/lib /usr/local/lib; do
        printf '%s/apptainer/bin\n%s/singularity/bin\n' "$base" "$base"
    done
    # Wherever the apptainer binary itself lives, its libexec is usually nearby.
    local ap
    if ap=$(command -v apptainer singularity 2>/dev/null | head -1); then
        ap=$(dirname "$(dirname "$(readlink -f "$ap")")")
        printf '%s/libexec/apptainer/bin\n%s/libexec/singularity/bin\n' "$ap" "$ap"
    fi
}

find_tool() {
    local want=$1 alt=${2:-} p d
    for p in "$want" $alt; do
        command -v "$p" 2>/dev/null && return 0
    done
    while read -r d; do
        for p in "$want" $alt; do
            [[ -x "$d/$p" ]] && { printf '%s\n' "$d/$p"; return 0; }
        done
    done < <(_libexec_dirs)
    return 1
}

SQUASHFUSE=$(find_tool squashfuse_ll squashfuse || true)
MKSQUASHFS=$(find_tool mksquashfs || true)
UNSQUASHFS=$(find_tool unsquashfs || true)
FUSERMOUNT=$(find_tool fusermount3 fusermount || true)
FLOCK=$(command -v flock || true)
PDEATHSIG=0
[[ $(setpriv --help 2>&1 || true) == *--pdeathsig* ]] && PDEATHSIG=1

REGISTRY=${HAVERSACK_REGISTRY:-${XDG_DATA_HOME:-$HOME/.local/share}/haversack}
LOCKS=$REGISTRY/locks
REFS=$REGISTRY/refs

die()  { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
warn() { printf '%s: %s\n' "$PROG" "$*" >&2; }
info() { [[ ${QUIET:-0} == 1 ]] || printf '%s\n' "$*" >&2; }

need() {
    local var=$1 what=$2
    [[ -n "${!var}" ]] || die "cannot find $what. Install squashfs-tools, fuse3 and util-linux, \
or run somewhere Apptainer/Singularity is installed (it bundles squashfuse and mksquashfs)."
}

# Inside 'haversack exec' the mount table is private and disappears with the
# command, so changing mounts from in there would only confuse things - and a
# squashfuse started there would keep the namespace alive after exit.
not_in_exec() {
    [[ -z ${HAVERSACK_NS:-} ]] || die "this shell is inside '$PROG exec ${HAVERSACK_NS}', \
where mounts are private and temporary. Run '$PROG $1' from outside it."
}

valid_name() {
    [[ $1 =~ ^[A-Za-z0-9._+-]+$ ]] || die "invalid environment name '$1' (letters, digits, . _ + - only)"
}

# --------------------------------------------------------------------- locks --
# One lock per environment, held on fd 8 for the life of the command, so two
# commands never pack, unpack, mount or unmount the same environment at once.
# Anything long-lived started while it is held must close fd 8 (7>&- 8>&-),
# or the lock outlives the command.  Over NFS this is as reliable as the
# server's lock manager.
lock_env() {                       # name wait-seconds (0: fail immediately)
    local name=$1 wait=$2
    need FLOCK "flock"
    mkdir -p "$LOCKS"
    exec 8>"$LOCKS/$name.lock"
    "$FLOCK" -n 8 && return 0
    [[ $wait -gt 0 ]] || die "another $PROG command is already working on '$name'"
    info "waiting for another $PROG command working on '$name' ..."
    "$FLOCK" -w "$wait" 8 || die "gave up after ${wait}s waiting for another $PROG command on '$name'"
}

unlock_env() { exec 8>&-; }

# ------------------------------------------------------------------ registry --
# One line per packed environment: <name>\t<image>\t<prefix>
index_file() { printf '%s/index\n' "$REGISTRY"; }

# Rewrites go through a private temp file under a registry-wide lock on fd 7,
# so concurrent commands on different environments cannot drop each other's
# rows.  Readers see either the old or the new file, never a partial one.
index_rewrite() {                  # awk-program [name image prefix]
    local prog=$1 name=${2:-} image=${3:-} prefix=${4:-} idx tmp
    need FLOCK "flock"
    idx=$(index_file); mkdir -p "$REGISTRY"; touch "$idx"
    {
        "$FLOCK" -w 60 7 || die "gave up after 60s waiting for the index lock"
        tmp=$(mktemp "$idx.XXXXXX")
        awk -F'\t' -v OFS='\t' -v n="$name" -v i="$image" -v p="$prefix" "$prog" "$idx" > "$tmp"
        mv "$tmp" "$idx"
    } 7>"$REGISTRY/index.lock"
}

index_put() { index_rewrite '$1 != n { print } END { print n, i, p }' "$1" "$2" "$3"; }
index_del() { index_rewrite '$1 != n { print }' "$1"; }

index_get() {                      # name -> "image<TAB>prefix", or nonzero
    local idx; idx=$(index_file)
    [[ -f "$idx" ]] || return 1
    awk -F'\t' -v n="$1" '$1 == n { print $2 "\t" $3; found = 1; exit } END { exit !found }' "$idx"
}

resolve() {                        # name [allow-missing] -> sets IMAGE, PREFIX
    local name=$1 row
    row=$(index_get "$name") || die "'$name' is not packed. Try: $PROG list"
    IMAGE=$(cut -f1 <<<"$row"); PREFIX=$(cut -f2 <<<"$row")
    [[ ${2:-} == allow-missing || -f "$IMAGE" ]] || die "image for '$name' is missing: $IMAGE"
}

# -------------------------------------------------------------------- mounts --
# The fstype of whatever is mounted at exactly this path, or nonzero if nothing
# is.  mountinfo escapes space, tab, newline and backslash as octal; the
# escaped path goes through the environment because awk -v would unescape it.
mount_fstype() {
    local p=$1
    p=${p//\\/\\134}; p=${p// /\\040}; p=${p//$'\t'/\\011}; p=${p//$'\n'/\\012}
    MI_PATH=$p awk '$5 == ENVIRON["MI_PATH"] {
        for (i = 7; i <= NF; i++) if ($i == "-") { t = $(i + 1); break }
        found = 1
    } END { if (!found) exit 1; print t }' /proc/self/mountinfo
}

# mounted | stale | none.  A squashfuse process that dies - killed at the end
# of a Slurm job, say - leaves its mount listed, but every access to the path
# fails with "Transport endpoint is not connected".  Probe with a directory
# read: stat can keep answering from the kernel's attribute cache for seconds
# after the daemon is gone, but only the daemon can list a directory.
mount_state() {
    mount_fstype "$1" >/dev/null || { echo none; return 0; }
    if ls -A -- "$1" >/dev/null 2>&1; then echo mounted; else echo stale; fi
}

is_mounted() { [[ $(mount_state "$1") != none ]]; }

clean_stale() {
    local d=$1 t
    [[ $(mount_state "$d") == stale ]] || return 0
    t=$(mount_fstype "$d")
    [[ $t == fuse* ]] || die "$d is a stale $t mount that $PROG did not make; not touching it"
    need FUSERMOUNT "fusermount"
    warn "clearing a stale mount at $d (its squashfuse process is gone)"
    "$FUSERMOUNT" -u "$d"
    [[ $(mount_state "$d") == none ]] || die "could not clear the stale mount at $d; try: $FUSERMOUNT -uz $d"
}

# A packed environment leaves a marker and a couple of stub files behind, so
# "is anything here" is not enough to tell a live environment from a packed
# mountpoint.  While the image is mounted it shadows the marker, which is what
# we want: a mounted environment reads as live.
is_sealed() { [[ -f "$1/.haversack-sealed" ]]; }
is_live() {
    is_sealed "$1" && return 1
    [[ -n "$(ls -A "$1" 2>/dev/null)" ]]
}

# The environment's path while its image is not mounted there.  Jobs and conda
# still reach for it, so every way in fails loudly instead of quietly doing the
# wrong thing:
#  - bin/ has a stub under every executable name the environment had, all
#    hardlinks to one file, so `python` says what to run rather than falling
#    through to whatever python is next on PATH;
#  - an activate.d hook warns anyone who activates the environment;
#  - conda-meta is a file, not a directory, so `conda create` or `install`
#    aimed at this name refuses instead of writing into the mountpoint.  conda
#    only lists directories with conda-meta/history, so `conda env list` still
#    shows the environment only where it is mounted.
# The mounted image shadows all of it.
make_mountpoint() {
    local prefix=$1 name=$2 image=$3 stub n
    stub=$prefix/bin/.haversack-stub
    mkdir -p "$prefix/bin" "$prefix/etc/conda/activate.d" || return 1
    printf '#!/bin/sh\necho "haversack: %s is packed but not mounted on this node, so ${0##*/} cannot run." >&2\necho "  in a batch job: haversack exec %s -- <cmd>    interactively: haversack mount %s" >&2\nexit 127\n' \
        "$name" "$name" "$name" > "$stub" || return 1
    chmod +x "$stub" || return 1
    while IFS= read -r n; do
        [[ -n $n && $n != .haversack-stub ]] || continue
        # A hardlink costs no inode; fall back to a symlink where they are not allowed.
        ln -f "$stub" "$prefix/bin/$n" 2>/dev/null || ln -sf .haversack-stub "$prefix/bin/$n" || return 1
    done < <("$UNSQUASHFS" -l "$image" | sed -n 's|^squashfs-root/bin/\([^/]*\)$|\1|p')
    printf 'echo "haversack: %s is packed but not mounted on this node; nothing in it will run." >&2\necho "  in a batch job: haversack exec %s -- <cmd>    interactively: haversack mount %s" >&2\n' \
        "$name" "$name" "$name" > "$prefix/etc/conda/activate.d/00-haversack-not-mounted.sh" || return 1
    printf 'packed by haversack and not mounted here; image: %s\n' "$image" > "$prefix/conda-meta" || return 1
    printf 'packed by haversack; image: %s\nmount with: haversack mount %s\n' \
        "$image" "$name" > "$prefix/NOT-MOUNTED.txt" || return 1
    : > "$prefix/.haversack-sealed"
}

# After a rebuild the executable names may have changed; the stubs follow the
# new image.  The directory itself stays, so a mount of it elsewhere is untouched.
refresh_mountpoint() {             # prefix name image
    find "$1" -mindepth 1 -delete
    make_mountpoint "$1" "$2" "$3" || die "the new image is in place, but the mountpoint at $1 could not be rebuilt"
}

# Deleting an environment is a rename to a sibling trash directory, then the
# mountpoint, then the actual delete.  The rename is atomic, so an interrupt
# leaves either the whole environment or a finished mountpoint, never half of
# one.  Leftovers of an interrupted run are cleared by the next command on
# that environment, once the process that made them is gone.
leftover_path() {                  # kind prefix
    printf '%s/.haversack-%s.%s.%s.%s\n' "$(dirname "$2")" "$1" "${2##*/}" "$HOST" "$$"
}

clean_leftovers() {
    local prefix=$1 t pid
    for t in "$(dirname "$prefix")/.haversack-"{trash,unpack}".${prefix##*/}.$HOST".*; do
        [[ -e $t ]] || continue
        pid=${t##*.}
        [[ -d /proc/$pid ]] && continue
        info "removing leftovers of an interrupted $PROG run: $t"
        rm -rf "$t"
    done
    return 0
}

# ---------------------------------------------------------------- processes --
# PIDs on this node with a file, executable, mapping or working directory under
# $1.  Only processes we are allowed to inspect are seen, which covers the
# caller's own.  Other nodes are invisible from here.
pids_using() {
    local prefix=$1 d pid seen
    for d in /proc/[0-9]*; do
        pid=${d#/proc/}
        [[ $pid == "$$" || $pid == "$BASHPID" ]] && continue
        # Every source ends its line with a path.  Suffixing "/" lets one
        # match catch the prefix itself (a cwd at the env root) as well as
        # anything under it, without matching "tz" for "tz2".  Read it all
        # rather than grep -q: an early exit SIGPIPEs the reader, and under
        # pipefail a large maps file would then hide the process.
        seen=$({ readlink "$d/exe"; readlink "$d/cwd"; ls -l "$d/fd"; cat "$d/maps"; } 2>/dev/null \
                | sed 's|$|/|' || true)
        [[ $seen == *"$prefix/"* ]] && printf '%s\n' "$pid"
    done
    return 0
}

proc_start() {                     # pid -> start time in clock ticks, or nonzero
    local s
    s=$(cat "/proc/$1/stat" 2>/dev/null) || return 1
    s=${s##*) }
    # shellcheck disable=SC2086
    set -- $s
    printf '%s\n' "${20}"
}

# Shells that ran 'activate' have the environment on PATH but nothing open in
# it, so no process scan can see them.  They register here, keyed by host, PID
# and process start time, so a recycled PID does not count as a user.
ref_add() {
    local name=$1 pid=$2 st
    st=$(proc_start "$pid") || return 0
    mkdir -p "$REFS/$name"
    printf '%s\n' "$st" > "$REFS/$name/$HOST.$pid"
}

ref_del() { rm -f "$REFS/$1/$HOST.$2"; }

live_refs() {                      # name -> PIDs on this host with it activated
    local name=$1 f pid st
    [[ -d "$REFS/$name" ]] || return 0
    for f in "$REFS/$name/$HOST".*; do
        [[ -e $f ]] || continue
        pid=${f##*.}
        if st=$(proc_start "$pid") && [[ $st == "$(cat "$f")" ]]; then
            printf '%s\n' "$pid"
        else
            rm -f "$f"
        fi
    done
    return 0
}

# ------------------------------------------------------------ namespace run --
# Run a command with an image mounted at a path inside a private mount
# namespace.  squashfuse runs in the foreground as a child of the runner and is
# unmounted on the way out: a daemonized squashfuse keeps the namespace, and
# the image file, alive long after the command has exited.  pdeathsig takes it
# down too if the runner itself is SIGKILLed.  Signals are caught with a no-op
# rather than ignored, so the command still gets the default handlers and the
# runner survives to clean up after it.
NS_RUNNER='
sf=$1 fm=$2 img=$3 pre=$4 pds=$5 nsname=$6; shift 6
before=$(stat -c %d "$pre" 2>/dev/null || true)
if [ "$pds" = 1 ]; then
    setpriv --pdeathsig TERM "$sf" -f "$img" "$pre" &
else
    "$sf" -f "$img" "$pre" &
fi
fp=$!
# Best-effort: either step fails harmlessly if squashfuse already exited.
cleanup() { "$fm" -u "$pre" 2>/dev/null; kill "$fp" 2>/dev/null; wait "$fp" 2>/dev/null; }
trap cleanup EXIT
trap : INT TERM HUP
# Wait for this mount specifically.  The path may already be a mount inherited
# from the host, which would satisfy a plain mountpoint test at once.
i=0
while :; do
    now=$(stat -c %d "$pre" 2>/dev/null || true)
    [ -n "$now" ] && [ "$now" != "$before" ] && break
    kill -0 "$fp" 2>/dev/null || { echo "haversack: squashfuse could not mount $img" >&2; exit 1; }
    i=$((i + 1))
    [ "$i" -gt 400 ] && { echo "haversack: timed out mounting $img" >&2; exit 1; }
    sleep 0.05
done
export HAVERSACK_NS="$nsname"
"$@"
'

# With NS_EXEC=1 this process becomes the runner, so killing the PID the user
# started takes squashfuse down with it instead of orphaning the runner.
ns_run() {                         # image prefix name command...
    local image=$1 prefix=$2 name=$3; shift 3
    local cmd=(unshare -Urm --map-root-user /bin/bash -c "$NS_RUNNER" _
               "$SQUASHFUSE" "$FUSERMOUNT" "$image" "$prefix" "$PDEATHSIG" "$name" "$@")
    if [[ ${NS_EXEC:-0} == 1 ]]; then exec "${cmd[@]}" 7>&- 8>&-; fi
    "${cmd[@]}" 7>&- 8>&-
}

have_userns() { unshare -Urm --map-root-user true 2>/dev/null; }

# ---------------------------------------------------------------- cmd: pack --
count_image() { "$UNSQUASHFS" -l "$1" | grep -c '^squashfs-root'; }

# Mount the image over the environment inside a private namespace and run the
# environment's python from it.  The namespace keeps the original visible to
# everyone else, so this is safe to do before anything is deleted.
smoke_test() {
    local image=$1 prefix=$2 name=$3
    have_userns || {
        warn "no user namespaces here; skipping the in-place smoke test"
        return 0
    }
    ns_run "$image" "$prefix" "$name" /bin/bash -c '
        pre=$1
        [ -e "$pre/.haversack-sealed" ] && { echo "image contains a packed mountpoint, not an environment" >&2; exit 1; }
        [ -x "$pre/bin/python" ] || exit 0
        "$pre/bin/python" -c "import sys; assert sys.prefix == sys.argv[1], (sys.prefix, sys.argv[1]); print(\"  python\", sys.version.split()[0], \"runs from the image\")" "$pre"
    ' _ "$prefix"
}

fix_cuda() {                       # src prefix: the files are in src, and will live at prefix
    local src=$1 prefix=$2 d nvdirs=() nvlib
    for d in "$src"/lib/python*/site-packages/nvidia/*/lib; do
        if [[ -d $d ]]; then nvdirs+=("$prefix${d#"$src"}"); fi
    done
    if [[ ${#nvdirs[@]} -eq 0 ]]; then
        info "--fix-cuda: no nvidia/*/lib directories found, nothing to do"
        return 0
    fi
    nvlib=$(IFS=:; printf '%s' "${nvdirs[*]}")
    mkdir -p "$src/etc/conda/activate.d" "$src/etc/conda/deactivate.d"
    # Wheel-shipped CUDA libraries are not on the loader path by default, so
    # frameworks find the driver and then fail to dlopen their own runtime.
    cat > "$src/etc/conda/activate.d/zz-haversack-cuda.sh" <<EOS
# added by haversack --fix-cuda
export HAVERSACK_OLD_LD_LIBRARY_PATH="\${LD_LIBRARY_PATH-}"
export LD_LIBRARY_PATH="$nvlib\${LD_LIBRARY_PATH:+:\$LD_LIBRARY_PATH}"
EOS
    cat > "$src/etc/conda/deactivate.d/zz-haversack-cuda.sh" <<'EOS'
# added by haversack --fix-cuda
if [ -n "${HAVERSACK_OLD_LD_LIBRARY_PATH+x}" ]; then
    if [ -n "$HAVERSACK_OLD_LD_LIBRARY_PATH" ]; then
        export LD_LIBRARY_PATH="$HAVERSACK_OLD_LD_LIBRARY_PATH"
    else
        unset LD_LIBRARY_PATH
    fi
    unset HAVERSACK_OLD_LD_LIBRARY_PATH
fi
EOS
    info "--fix-cuda: added ${#nvdirs[@]} CUDA wheel lib dirs to activate.d"
}

# Heavy work - conda solves, compression - belongs in a job on a cluster, not
# on a shared login node.  Say so rather than refuse: not every site is a
# cluster, and not every cluster forbids it.
warn_if_login_node() {
    if command -v sbatch >/dev/null 2>&1 && [[ -z ${SLURM_JOB_ID:-} ]]; then
        warn "this looks like a Slurm login node, and '$1' does real work here. Consider running it inside an allocation (salloc)."
    fi
    return 0
}

# Pack src into image for an environment that lives at prefix: under a
# temporary name, check the image holds every inode, run the environment's
# python from it at prefix, and only then move it into place.  src is prefix
# itself when packing an existing environment, or a node-local build.
# Sets BUILT_INODES.
build_image() {                    # src prefix name image jobs comp level
    local src=$1 prefix=$2 name=$3 image=$4 jobs=$5 comp=$6 level=$7 partial n_src n_img
    partial=$image.partial.$HOST.$$
    CLEANUP+=("$partial")
    n_src=$(find "$src" | wc -l)
    info "packing $name ($n_src inodes) -> $image"
    "$MKSQUASHFS" "$src" "$partial" -noappend -comp "$comp" \
        -Xcompression-level "$level" -processors "$jobs" -no-progress >/dev/null 7>&- 8>&-
    # An image with fewer inodes than the source would silently drop part of
    # the environment once the original is gone.
    n_img=$(count_image "$partial")
    [[ $n_img -eq $n_src ]] || die "image holds $n_img inodes but the source had $n_src -- image discarded"
    info "image: $n_img inodes, $(du -h "$partial" | cut -f1) (source $(du -sh "$src" | cut -f1))"
    smoke_test "$partial" "$prefix" "$name" || \
        die "the environment does not run from its image -- image discarded, nothing else changed"
    mv -f "$partial" "$image"
    BUILT_INODES=$n_img
}

cmd_pack() {
    local env="" to="" name="" jobs=${SLURM_CPUS_PER_TASK:-$(nproc)} comp=zstd level=8
    local fix=0 keep=0 yes=0 force=0
    while [[ $# -gt 0 ]]; do
        case $1 in
            --to)        to=$2; shift 2 ;;
            --name)      name=$2; shift 2 ;;
            -j|--jobs)   jobs=$2; shift 2 ;;
            --comp)      comp=$2; shift 2 ;;
            --level)     level=$2; shift 2 ;;
            --fix-cuda)  fix=1; shift ;;
            --keep)      keep=1; shift ;;
            -y|--yes)    yes=1; shift ;;
            --force)     force=1; shift ;;
            -*)          die "pack: unknown option $1" ;;
            *)           env=$1; shift ;;
        esac
    done
    [[ -n "$env" ]] || die "usage: $PROG pack <env-path> [--keep] [-y] [--force] [--name N] [--to DIR] [-j N] [--fix-cuda]"
    need MKSQUASHFS "mksquashfs"; need UNSQUASHFS "unsquashfs"
    need SQUASHFUSE "squashfuse"; need FUSERMOUNT "fusermount"
    warn_if_login_node pack

    [[ -d "$env" ]] || die "no such directory: $env"
    local prefix image row
    prefix=$(cd "$env" && pwd -P)
    name=${name:-${prefix##*/}}
    valid_name "$name"
    lock_env "$name" 0
    clean_stale "$prefix"
    clean_leftovers "$prefix"
    is_mounted "$prefix" && die "$prefix is a mounted image; it is already packed"
    is_sealed "$prefix" && die "$prefix is already packed (image mountpoint)"
    if row=$(index_get "$name") && [[ $(cut -f2 <<<"$row") != "$prefix" ]]; then
        die "the name '$name' already belongs to $(cut -f2 <<<"$row").
Pass --name to register this environment under a different name."
    fi
    [[ -f "$prefix/conda-meta/history" ]] || \
        warn "$prefix does not look like a conda environment; packing it anyway"

    # Default the image beside the environment, so it lands on the same
    # filesystem and next to the mountpoint it will be mounted at.
    to=${to:-${HAVERSACK_IMAGES:-$(dirname "$prefix")/.haversack}}
    mkdir -p "$to"
    image=$(cd "$to" && pwd -P)/$name.sqfs

    [[ $fix == 1 ]] && fix_cuda "$prefix" "$prefix"
    build_image "$prefix" "$prefix" "$name" "$image" "$jobs" "$comp" "$level"
    index_put "$name" "$image" "$prefix"

    if [[ $keep == 1 ]]; then
        info "kept the original (--keep). Run '$PROG pack $prefix' to replace it."
        return 0
    fi

    local busy
    busy=$(pids_using "$prefix" | paste -sd' ' -)
    if [[ -n "$busy" && $force != 1 ]]; then
        die "processes on this node are using $prefix (PIDs: $busy).
Deleting it under them will crash them. Stop them, or pass --force.
The image is built and registered; nothing was deleted."
    fi

    if [[ $yes != 1 ]]; then
        [[ -t 0 ]] || die "no terminal to confirm the delete; pass -y. The image is built; nothing was deleted."
        printf 'Delete %s (%s inodes)? Recoverable with: %s unpack %s\n' "$prefix" "$BUILT_INODES" "$PROG" "$name" >&2
        local reply
        read -r -p "Type '$name' to confirm: " reply
        [[ "$reply" == "$name" ]] || die "not confirmed; the image is built and nothing was deleted"
    fi

    # The environment may have changed while the image was being built and
    # tested.  Check once more immediately before the image becomes the only copy.
    local n_now
    n_now=$(find "$prefix" | wc -l)
    [[ $n_now -eq $BUILT_INODES ]] || die "$prefix changed during packing ($BUILT_INODES -> $n_now inodes); run pack again"

    local trash
    trash=$(leftover_path trash "$prefix")
    trap '' INT TERM HUP
    mv "$prefix" "$trash"
    if ! make_mountpoint "$prefix" "$name" "$image"; then
        rm -rf "$prefix"
        mv "$trash" "$prefix"
        die "could not create the mountpoint at $prefix; the environment was put back"
    fi
    trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP

    info "removing the original ..."
    rm -rf "$trash" || warn "could not fully remove $trash; the environment is packed, delete that by hand"
    # Count inodes, not names: the stubs are hardlinks.
    info "packed $name: $BUILT_INODES inodes -> $(find "$prefix" "$image" -printf '%i\n' | sort -u | wc -l)"
    info "use it with: $PROG mount $name   or   $PROG exec $name -- <cmd>"
}

# ------------------------------------------------------ cmd: create / change --
find_conda() {
    local c=${HAVERSACK_CONDA:-}
    [[ -n $c ]] || c=$(command -v conda || command -v mamba || command -v micromamba || true)
    [[ -n $c ]] || die "no conda, mamba or micromamba on PATH. Load one first (e.g. module load miniconda), or set HAVERSACK_CONDA."
    CONDA=$c
}

# Where 'conda create -n NAME' would put NAME: the first envs directory.
conda_envs_dir() {
    local d
    d=$("$CONDA" config --show envs_dirs | awk '/^ *- / { print $2; exit }' || true)
    [[ -n $d ]] || d=${CONDA_ENVS_PATH:+${CONDA_ENVS_PATH%%:*}}
    [[ -n $d ]] || die "could not tell where $CONDA puts named environments; pass -p PATH instead of -n"
    printf '%s\n' "$d"
}

# Sets BUILD rather than printing it: called in $(...), the addition to
# CLEANUP would happen in a subshell and the directory would never be removed.
new_build_dir() {                  # name -> sets BUILD to a fresh node-local build directory
    local root=${HAVERSACK_BUILD_DIR:-${TMPDIR:-/tmp}}
    mkdir -p "$root"
    BUILD=$(mktemp -d "$root/haversack-build.$1.XXXXXX")
    CLEANUP+=("$BUILD")
}

# Run a command against prefix with the node-local directory src bound over
# it, inside a private mount namespace.  conda sees the environment's real
# path, so everything it bakes in names the final location, while every file
# it writes lands on local disk.  The only traces of the build left in the
# environment are conda's notes of where its package cache was, which nothing
# reads once the build is finished.
build_ns() {                       # src prefix pkgs command...
    local src=$1 prefix=$2 pkgs=$3; shift 3
    CONDA_PKGS_DIRS=$pkgs unshare -Urm --map-root-user /bin/bash -c '
        mount --bind "$1" "$2" || { echo "haversack: could not bind the build directory over $2" >&2; exit 1; }
        shift 2
        "$@"
    ' _ "$src" "$prefix" "$@" 7>&- 8>&-
}

build_prereqs() {
    need MKSQUASHFS "mksquashfs"; need UNSQUASHFS "unsquashfs"
    need SQUASHFUSE "squashfuse"; need FUSERMOUNT "fusermount"
    have_userns || die "building needs unprivileged user namespaces, which are unavailable here"
    find_conda
    warn_if_login_node "$1"
}

cmd_create() {
    local name="" prefix="" file="" to="" jobs=${SLURM_CPUS_PER_TASK:-$(nproc)} comp=zstd level=8 fix=0
    local args=()
    while [[ $# -gt 0 ]]; do
        case $1 in
            -n|--name)   name=$2; shift 2 ;;
            -p|--prefix) prefix=$2; shift 2 ;;
            -f|--file)   file=$2; shift 2 ;;
            --to)        to=$2; shift 2 ;;
            -j|--jobs)   jobs=$2; shift 2 ;;
            --level)     level=$2; shift 2 ;;
            --fix-cuda)  fix=1; shift ;;
            --)          shift; args+=("$@"); break ;;
            *)           args+=("$1"); shift ;;
        esac
    done
    [[ -n $name || -n $prefix ]] || die "usage: $PROG create -n NAME | -p PATH [-f env.yml] [--fix-cuda] [conda create arguments...]"
    build_prereqs create

    [[ -n $prefix ]] || prefix=$(conda_envs_dir)/$name
    mkdir -p "$(dirname "$prefix")"
    prefix=$(cd "$(dirname "$prefix")" && pwd -P)/${prefix##*/}
    name=${name:-${prefix##*/}}
    valid_name "$name"
    lock_env "$name" 0
    index_get "$name" >/dev/null && die "'$name' already exists. Change it with '$PROG install|update|remove $name ...'."
    clean_stale "$prefix"
    is_mounted "$prefix" && die "$prefix is mounted; not building over it"
    if [[ -e $prefix && -n "$(ls -A "$prefix")" ]]; then
        die "$prefix already exists and is not empty. To turn an existing environment into an image, use '$PROG pack $prefix'."
    fi
    to=${to:-${HAVERSACK_IMAGES:-$(dirname "$prefix")/.haversack}}
    mkdir -p "$to"
    local image; image=$(cd "$to" && pwd -P)/$name.sqfs
    [[ ! -e $image ]] || die "$image already exists; move it aside or pass --to"

    local build src pkgs cmd
    new_build_dir "$name"; build=$BUILD
    src=$build/prefix; pkgs=${HAVERSACK_PKGS_DIR:-$build/pkgs}
    [[ -e $prefix ]] || CLEANUP_EMPTY+=("$prefix")
    mkdir -p "$src" "$pkgs" "$prefix"
    if [[ -n $file ]]; then
        file=$(cd "$(dirname "$file")" && pwd -P)/${file##*/}
        case ${CONDA##*/} in
            micromamba) cmd=("$CONDA" create -y -p "$prefix" -f "$file" "${args[@]}") ;;
            *)          cmd=("$CONDA" env create -p "$prefix" -f "$file" "${args[@]}") ;;
        esac
    else
        cmd=("$CONDA" create -y -p "$prefix" "${args[@]}")
    fi
    info "building $name in $build"
    build_ns "$src" "$prefix" "$pkgs" "${cmd[@]}" || die "${CONDA##*/} failed; nothing was created"
    [[ -d $src/conda-meta ]] || die "${CONDA##*/} finished but left no environment behind; nothing was created"

    [[ $fix == 1 ]] && fix_cuda "$src" "$prefix"
    build_image "$src" "$prefix" "$name" "$image" "$jobs" "$comp" "$level"
    index_put "$name" "$image" "$prefix"
    make_mountpoint "$prefix" "$name" "$image" || die "the image is registered, but the mountpoint at $prefix could not be made"
    info "created $name: $BUILT_INODES inodes packed into $image"
    info "use it with: $PROG exec $name -- <cmd>   or   $PROG mount $name"
}

# install / update / remove: unpack the image to node-local disk, run the
# conda command there at the environment's real path, and pack the result as
# the new image.  The old image is replaced by a rename, so commands already
# running from it keep using it until they exit.
cmd_rebuild() {
    local verb=$1; shift
    local name="" jobs=${SLURM_CPUS_PER_TASK:-$(nproc)} comp=zstd level=8 fix=0 args=()
    if [[ $# -gt 0 && $1 != -* ]]; then name=$1; shift; fi
    while [[ $# -gt 0 ]]; do
        case $1 in
            -n|--name)  name=$2; shift 2 ;;
            -j|--jobs)  jobs=$2; shift 2 ;;
            --level)    level=$2; shift 2 ;;
            --fix-cuda) fix=1; shift ;;
            --)         shift; args+=("$@"); break ;;
            *)          args+=("$1"); shift ;;
        esac
    done
    [[ -n $name ]] || die "usage: $PROG $verb NAME [conda $verb arguments...]"
    build_prereqs "$verb"
    resolve "$name"
    lock_env "$name" 0
    clean_stale "$PREFIX"
    if [[ $(mount_state "$PREFIX") == mounted ]]; then
        die "'$name' is mounted on this node; unmount it first ($PROG umount $name).
Commands running under '$PROG exec' are not affected by changing the environment."
    fi
    if is_live "$PREFIX"; then
        die "the original environment is still at $PREFIX (packed with --keep).
Change it with ${CONDA##*/} directly, then run '$PROG pack $PREFIX'."
    fi

    local build src pkgs n_before
    new_build_dir "$name"; build=$BUILD
    src=$build/prefix; pkgs=${HAVERSACK_PKGS_DIR:-$build/pkgs}
    mkdir -p "$pkgs"
    info "unpacking $name into $build"
    "$UNSQUASHFS" -d "$src" "$IMAGE" >/dev/null 7>&- 8>&-
    n_before=$(find "$src" | wc -l)
    build_ns "$src" "$PREFIX" "$pkgs" "$CONDA" "$verb" -y -p "$PREFIX" "${args[@]}" || \
        die "${CONDA##*/} $verb failed; the image is unchanged"

    [[ $fix == 1 ]] && fix_cuda "$src" "$PREFIX"
    build_image "$src" "$PREFIX" "$name" "$IMAGE" "$jobs" "$comp" "$level"
    refresh_mountpoint "$PREFIX" "$name" "$IMAGE"
    info "$verb done: $name has $BUILT_INODES inodes (was $n_before)"
}

# edit: unpack to node-local disk and open a shell - or run one command - with
# the environment writable at its real path, then pack whatever changed as the
# new image.  This is how pip gets into a packed environment, and how several
# changes cost a single repack.
cmd_edit() {
    local name=${1:?usage: $PROG edit NAME [-- command...]}; shift
    local jobs=${SLURM_CPUS_PER_TASK:-$(nproc)} comp=zstd level=8
    while [[ $# -gt 0 ]]; do
        case $1 in
            -j|--jobs) jobs=$2; shift 2 ;;
            --level)   level=$2; shift 2 ;;
            --)        shift; break ;;
            *)         break ;;
        esac
    done
    local cmd=("$@")
    need MKSQUASHFS "mksquashfs"; need UNSQUASHFS "unsquashfs"
    need SQUASHFUSE "squashfuse"; need FUSERMOUNT "fusermount"
    have_userns || die "editing needs unprivileged user namespaces, which are unavailable here"
    not_in_exec edit
    warn_if_login_node edit
    resolve "$name"
    lock_env "$name" 0
    clean_stale "$PREFIX"
    if [[ $(mount_state "$PREFIX") == mounted ]]; then
        die "'$name' is mounted on this node; unmount it first ($PROG umount $name)"
    fi
    if is_live "$PREFIX"; then
        die "the original environment is still at $PREFIX (packed with --keep); change it directly, then run '$PROG pack $PREFIX'"
    fi

    local build src marker rc
    new_build_dir "$name"; build=$BUILD
    src=$build/prefix
    mkdir -p "$build/pkgs"
    info "unpacking $name into $build"
    "$UNSQUASHFS" -d "$src" "$IMAGE" >/dev/null 7>&- 8>&-
    # Anything changed after this - written, removed, renamed, chmodded -
    # has a newer ctime than the marker, or its directory does.
    marker=$build/.edit-start
    : > "$marker"
    sleep 1

    local inside
    inside="$(env_snippet "$PREFIX" "$name")"$'\n'"export HAVERSACK_NS=$(printf '%q' "$name")"
    set +e
    if [[ ${#cmd[@]} -gt 0 ]]; then
        build_ns "$src" "$PREFIX" "$build/pkgs" /bin/bash -c "$inside"$'\n''exec "$@"' _ "${cmd[@]}"
        rc=$?
    else
        { echo '[ -f ~/.bashrc ] && . ~/.bashrc'
          printf '%s\n' "$inside"
          printf 'PS1="(haversack edit %s) ${PS1-\\$ }"\n' "$name"
        } > "$build/.editrc"
        info "editing $name: it is writable at $PREFIX in this shell. Use conda or pip as usual, then exit."
        build_ns "$src" "$PREFIX" "$build/pkgs" /bin/bash --rcfile "$build/.editrc" -i
        rc=0
    fi
    set -e
    [[ $rc -eq 0 ]] || die "the command exited with status $rc; nothing was saved"

    if [[ -z $(find "$src" -cnewer "$marker" -print -quit) ]]; then
        info "no changes; $name is unchanged"
        return 0
    fi
    if [[ ${#cmd[@]} -eq 0 && -t 0 ]]; then
        local reply
        read -r -p "Save the changes to $name? [y/N] " reply
        [[ $reply == [yY]* ]] || { info "discarded; $name is unchanged"; return 0; }
    fi
    build_image "$src" "$PREFIX" "$name" "$IMAGE" "$jobs" "$comp" "$level"
    refresh_mountpoint "$PREFIX" "$name" "$IMAGE"
    info "saved $name: $BUILT_INODES inodes"
}

# -------------------------------------------------------------- cmd: mount --
cmd_mount() {
    local name=${1:?usage: $PROG mount <name>}
    not_in_exec mount
    need SQUASHFUSE "squashfuse"; need FUSERMOUNT "fusermount"
    resolve "$name"
    lock_env "$name" 60
    clean_stale "$PREFIX"
    # Slurm ends every process of a job when the job ends, squashfuse included,
    # so a mount made in one job disappears from under every other job on the
    # node that is using it.
    if [[ -n ${SLURM_JOB_ID:-} ]]; then
        warn "inside Slurm job $SLURM_JOB_ID, a mount lasts only as long as the job that made it, and
other jobs on $HOST using it lose it when that job ends. In batch jobs, use '$PROG exec $name -- <cmd>'."
    fi
    if [[ $(mount_state "$PREFIX") == mounted ]]; then info "already mounted: $PREFIX"; return 0; fi
    clean_leftovers "$PREFIX"
    if is_live "$PREFIX"; then
        die "the original environment is still at $PREFIX (packed with --keep).
Mounting over it would shadow it for every process on this node.
Use '$PROG exec $name -- <cmd>' to try the image, or '$PROG pack $PREFIX' to replace the original."
    fi
    mkdir -p "$PREFIX"
    "$SQUASHFUSE" "$IMAGE" "$PREFIX" </dev/null >/dev/null 7>&- 8>&-
    [[ $(mount_state "$PREFIX") == mounted ]] || die "squashfuse exited cleanly but nothing is mounted at $PREFIX"
    info "mounted $name at $PREFIX"
}

cmd_umount() {
    local name="" force=0
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f|--force) force=1; shift ;;
            -*)         die "umount: unknown option $1" ;;
            *)          name=$1; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: $PROG umount <name> [--force]"
    not_in_exec umount
    need FUSERMOUNT "fusermount"
    resolve "$name" allow-missing
    lock_env "$name" 60
    clean_stale "$PREFIX"
    if [[ $(mount_state "$PREFIX") != mounted ]]; then info "not mounted: $PREFIX"; return 0; fi

    # The kernel refuses to unmount while files are open in the mount, but a
    # shell that only has the environment on PATH holds nothing open and would
    # find it gone on its next command.  Check for both, to say who is using it.
    if [[ $force != 1 ]]; then
        local refs busy
        refs=$(live_refs "$name" | paste -sd' ' -)
        busy=$(pids_using "$PREFIX" | paste -sd' ' -)
        if [[ -n $refs || -n $busy ]]; then
            die "'$name' is still in use on this node:
${busy:+  processes running from it: $busy
}${refs:+  shells with it activated: $refs (in each: eval \"\$($PROG deactivate)\")
}Unmounting now would break them. Stop them, or pass --force."
        fi
        "$FUSERMOUNT" -u "$PREFIX" || die "$PREFIX is busy: something on this node still has files open in it.
Stop it, or pass --force."
    else
        # Lazy: the path is detached now, and programs already inside keep
        # what they have open until they exit.
        "$FUSERMOUNT" -uz "$PREFIX"
    fi
    [[ $(mount_state "$PREFIX") == none ]] || die "$PREFIX is still mounted after unmounting"
    rm -f "$REFS/$name/$HOST".*
    info "unmounted $name"
}

# --------------------------------------------------------------- cmd: exec --
# Mount inside a private mount namespace and run one command.  The mount is
# torn down with the command, so nothing is left behind and nothing is visible
# to anyone else - the right mode for one-offs, for shared environments, and
# for batch jobs that may be killed.
cmd_exec() {
    local name=${1:?usage: $PROG exec <name> [--] <command>...}; shift
    [[ ${1:-} == -- ]] && shift
    [[ $# -gt 0 ]] || die "usage: $PROG exec <name> [--] <command>..."
    need SQUASHFUSE "squashfuse"; need FUSERMOUNT "fusermount"
    resolve "$name"

    local run state
    run="$(env_snippet "$PREFIX" "$name")"$'\n''exec "$@"'
    state=$(mount_state "$PREFIX")
    if [[ $state == stale ]]; then
        lock_env "$name" 60
        clean_stale "$PREFIX"
        unlock_env
        state=$(mount_state "$PREFIX")
    fi
    # Already inside an exec of this environment: its private mount is right
    # here.  A mount made by 'mount' is never reused, even when present: it
    # lives only as long as the process that made it - in a batch job, as long
    # as that job - and would take this command's files with it when it goes.
    if [[ ${HAVERSACK_NS:-} == "$name" && $state == mounted ]] && is_live "$PREFIX"; then
        exec /bin/bash -c "$run" _ "$@"
    fi

    have_userns || die "unprivileged user namespaces are unavailable, so '$PROG exec' cannot work here.
Use '$PROG mount $name' instead, and unmount when you are done."
    # If the original is still there (--keep), the image shadows it only
    # inside the namespace, which is exactly what trying the image needs.
    [[ $state == none ]] && mkdir -p "$PREFIX"
    NS_EXEC=1 ns_run "$IMAGE" "$PREFIX" "$name" /bin/bash -c "$run" _ "$@"
}

cmd_shell() {
    local name=${1:?usage: $PROG shell <name>}
    resolve "$name"
    local sh=${SHELL:-/bin/bash} rc
    if [[ ${sh##*/} != bash ]]; then
        cmd_exec "$name" -- "$sh"
    fi
    # An interactive bash reads ~/.bashrc after the environment is set up, and
    # anything there that puts directories in front of PATH would shadow the
    # environment's own executables.  Hand it an rc file that reads ~/.bashrc
    # first and sets up the environment after.  It goes in on an inherited file
    # descriptor: this process is replaced by the namespace runner, so a
    # temporary file would never be cleaned up.
    rc='[ -f ~/.bashrc ] && . ~/.bashrc'$'\n'"$(env_snippet "$PREFIX" "$name")"$'\n'
    rc+="PS1=\"($name) \${PS1-\\\$ }\""
    exec 9<<<"$rc"
    cmd_exec "$name" -- "$sh" --rcfile /dev/fd/9 -i
}

# ----------------------------------------------------------- cmd: activate --
# What being inside the environment means: the variables conda would set, and
# the environment's own activation hooks.
env_snippet() {
    local prefix=$1 name=$2
    cat <<EOF
export CONDA_PREFIX=$(printf '%q' "$prefix")
export CONDA_DEFAULT_ENV=$(printf '%q' "$name")
export PATH="\$CONDA_PREFIX/bin:\$PATH"
for _cs_f in "\$CONDA_PREFIX"/etc/conda/activate.d/*.sh; do
    [ -e "\$_cs_f" ] && . "\$_cs_f"
done
unset _cs_f
EOF
}

# Emits shell code; meant to be used as:  eval "$(haversack activate tz)"
cmd_activate() {
    local name=${1:?usage: eval \"\$($PROG activate <name>)\"}
    resolve "$name"
    local self_q; self_q=$(printf '%q' "$SELF")

    if [[ ${HAVERSACK_ACTIVE:-} == "$name" ]]; then
        # Already active here.  Only make sure this shell is registered - it
        # may be a child that inherited the environment from its parent.
        printf '%s _ref add %q "$$"\n' "$self_q" "$name"
        return 0
    fi
    # Mount here rather than emitting shell to do it, so a failure is reported
    # by this process instead of being eval'd into the caller's shell.
    if ! { [[ $(mount_state "$PREFIX") == mounted ]] && is_live "$PREFIX"; }; then
        QUIET=1 cmd_mount "$name"
        unlock_env
    fi
    # Register the calling shell now, so an umount cannot slip in between
    # this mount and the eval.  The emitted line registers it again by its own
    # $$, in case the caller ran this from a subshell.
    ref_add "$name" "$PPID"
    [[ -n ${HAVERSACK_ACTIVE:-} ]] && cmd_deactivate
    printf 'export HAVERSACK_OLD_PATH="${HAVERSACK_OLD_PATH-$PATH}"\n'
    printf 'export HAVERSACK_ACTIVE=%q\n' "$name"
    env_snippet "$PREFIX" "$name"
    printf '%s _ref add %q "$$"\n' "$self_q" "$name"
}

cmd_deactivate() {
    local name=${HAVERSACK_ACTIVE:-}
    if [[ -z $name ]]; then echo ':'; return 0; fi
    cat <<'EOF'
for _cs_f in "$CONDA_PREFIX"/etc/conda/deactivate.d/*.sh; do
    [ -e "$_cs_f" ] && . "$_cs_f"
done
unset _cs_f
[ -n "${HAVERSACK_OLD_PATH+x}" ] && export PATH="$HAVERSACK_OLD_PATH"
EOF
    # activate registered the caller by this process's parent and by the
    # emitted $$.  Inside a subshell those are different processes ($$ keeps
    # the outer shell's PID), so drop both.
    ref_del "$name" "$PPID"
    printf '%q _ref del %q "$$"\n' "$SELF" "$name"
    echo 'unset HAVERSACK_OLD_PATH HAVERSACK_ACTIVE CONDA_PREFIX CONDA_DEFAULT_ENV'
}

cmd__ref() {
    case ${1:-} in
        add) ref_add "${2:?}" "${3:?}" ;;
        del) ref_del "${2:?}" "${3:?}" ;;
        *)   die "internal: _ref add|del <name> <pid>" ;;
    esac
}

# ---------------------------------------------------------------- cmd: delete --
cmd_delete() {
    local name="" yes=0
    while [[ $# -gt 0 ]]; do
        case $1 in
            -y|--yes) yes=1; shift ;;
            -*)       die "delete: unknown option $1" ;;
            *)        name=$1; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: $PROG delete <name> [-y]"
    not_in_exec delete
    resolve "$name" allow-missing
    lock_env "$name" 0
    clean_stale "$PREFIX"
    if [[ $(mount_state "$PREFIX") == mounted ]]; then
        die "'$name' is mounted on this node; unmount it first ($PROG umount $name)"
    fi
    if is_live "$PREFIX"; then
        die "the original environment is still at $PREFIX (packed with --keep), so deleting the image would not delete the environment.
To drop just the image: '$PROG forget $name' and remove $IMAGE."
    fi
    if [[ $yes != 1 ]]; then
        [[ -t 0 ]] || die "no terminal to confirm the delete; pass -y. Nothing was deleted."
        printf 'Delete %s and its image %s? This cannot be undone.\n' "$PREFIX" "$IMAGE" >&2
        local reply
        read -r -p "Type '$name' to confirm: " reply
        [[ "$reply" == "$name" ]] || die "not confirmed; nothing was deleted"
    fi
    # Unregister first, so an interrupted delete leaves stray files rather than
    # a name that points at nothing.  Commands already running from the image
    # hold it open and keep it until they exit.
    index_del "$name"
    rm -f -- "$IMAGE"
    # Empty the mountpoint but keep the directory: removing a directory detaches
    # every mount on it, including the private mounts of commands still running
    # from this environment under exec, on this node or any other.
    if is_sealed "$PREFIX"; then
        find "$PREFIX" -mindepth 1 -delete
    fi
    rm -rf -- "${REFS:?}/$name"
    rm -f -- "$LOCKS/$name.lock"
    if [[ -d $(dirname "$IMAGE") ]]; then rmdir --ignore-fail-on-non-empty -- "$(dirname "$IMAGE")"; fi
    info "deleted $name"
    if [[ -d $PREFIX ]]; then
        info "left the empty directory $PREFIX; remove it with rmdir once nothing is running from it"
    fi
}

# -------------------------------------------------------------- cmd: unpack --
cmd_unpack() {
    local name=${1:?usage: $PROG unpack <name>}
    not_in_exec unpack
    need UNSQUASHFS "unsquashfs"
    resolve "$name"
    lock_env "$name" 0
    clean_stale "$PREFIX"
    is_mounted "$PREFIX" && die "unmount first: $PROG umount $name"
    clean_leftovers "$PREFIX"
    is_live "$PREFIX" && die "$PREFIX already holds files; move them aside first"

    # Restore beside the mountpoint and swap it in only once complete, so an
    # interrupt never leaves a partial environment at the real path.
    local tmp n_img n_tmp
    tmp=$(leftover_path unpack "$PREFIX")
    CLEANUP+=("$tmp")
    info "restoring $name ..."
    "$UNSQUASHFS" -d "$tmp" "$IMAGE" >/dev/null 7>&- 8>&-
    n_img=$(count_image "$IMAGE"); n_tmp=$(find "$tmp" | wc -l)
    [[ $n_tmp -eq $n_img ]] || die "restored copy has $n_tmp inodes but the image has $n_img; nothing changed"

    trap '' INT TERM HUP
    rm -rf "$PREFIX"
    mv "$tmp" "$PREFIX"
    trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
    info "restored $name to $PREFIX ($n_tmp inodes)"
    info "the image is still at $IMAGE; remove it and run '$PROG forget $name' when you are sure"
}

cmd_forget() {
    local name="" force=0 row image prefix
    while [[ $# -gt 0 ]]; do
        case $1 in
            -f|--force) force=1; shift ;;
            -*)         die "forget: unknown option $1" ;;
            *)          name=$1; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage: $PROG forget <name> [--force]"
    row=$(index_get "$name") || die "'$name' is not in the index"
    image=$(cut -f1 <<<"$row"); prefix=$(cut -f2 <<<"$row")
    lock_env "$name" 60
    is_mounted "$prefix" && die "'$name' is mounted on this node; unmount it first"
    if [[ $force != 1 ]] && is_sealed "$prefix" && [[ -f $image ]]; then
        die "'$name' is packed: $image is the only copy of the environment, and
forgetting it leaves $prefix as a bare mountpoint. Run '$PROG unpack $name' first, or pass --force."
    fi
    index_del "$name"
    rm -rf "${REFS:?}/$name"
    info "forgot $name"
}

# --------------------------------------------------------------- cmd: list --
cmd_list() {
    local idx; idx=$(index_file)
    [[ -s "$idx" ]] || { info "nothing packed yet"; return 0; }
    printf '%-20s %-10s %-9s %s\n' NAME SIZE STATE PREFIX
    local name image prefix state size
    while IFS=$'\t' read -r name image prefix; do
        state=$(mount_state "$prefix")
        if   [[ ! -f "$image" ]];   then state=MISSING
        elif [[ $state == stale ]]; then :
        elif [[ $state == mounted ]]; then :
        elif is_live "$prefix";     then state=kept
        else                             state=packed
        fi
        size=$([[ -f "$image" ]] && du -h "$image" | cut -f1 || echo -)
        printf '%-20s %-10s %-9s %s\n' "$name" "$size" "$state" "$prefix"
    done < "$idx"
}

# ------------------------------------------------------------- cmd: verify --
cmd_verify() {
    local name=${1:?usage: $PROG verify <name>}
    resolve "$name"
    info "verifying $name ..."
    ( cmd_exec "$name" -- /bin/bash -c '
        set -e
        [ -x "$CONDA_PREFIX/bin/python" ] || { echo "no python in env"; exit 0; }
        "$CONDA_PREFIX/bin/python" - <<PY
import sys
print("  python", sys.version.split()[0], "prefix", sys.prefix)
PY
    ' ) || die "verification failed"
    info "ok"
}

cmd_doctor() {
    printf '%s %s\n\n' "$PROG" "$VERSION"
    printf '%-14s %s\n' squashfuse  "${SQUASHFUSE:-NOT FOUND}"
    printf '%-14s %s\n' mksquashfs  "${MKSQUASHFS:-NOT FOUND}"
    printf '%-14s %s\n' unsquashfs  "${UNSQUASHFS:-NOT FOUND}"
    printf '%-14s %s\n' fusermount  "${FUSERMOUNT:-NOT FOUND}"
    printf '%-14s %s\n' flock       "${FLOCK:-NOT FOUND}"
    printf '%-14s %s\n' registry    "$REGISTRY"
    if have_userns; then
        printf '%-14s yes (haversack exec available)\n' 'user ns'
    else
        printf '%-14s no (use mount/umount instead of exec)\n' 'user ns'
    fi
    if [[ $PDEATHSIG == 1 ]]; then
        printf '%-14s yes (exec cleans up even if killed)\n' pdeathsig
    else
        printf '%-14s no (a SIGKILLed exec can leave a squashfuse process behind)\n' pdeathsig
    fi
    if [[ -r /etc/fuse.conf ]] && grep -qE '^\s*user_allow_other' /etc/fuse.conf; then
        printf '%-14s yes (mounts can be shared with other users)\n' allow_other
    else
        printf '%-14s no (each user must mount for themselves)\n' allow_other
    fi
}

usage() {
    cat <<EOF
$PROG $VERSION - collapse a conda environment into a single squashfs image

  $PROG pack <env-path> [--keep] [-y] [--force] [--name N] [--to DIR] [-j N] [--fix-cuda]
        Build <name>.sqfs, check it holds every inode, run the environment's
        python from the mounted image, then delete the original.
          --keep    stop before deleting
          -y        do not prompt before deleting
          --force   delete even if processes on this node are using the env
          --name    register under a name other than the directory's
  $PROG create -n NAME | -p PATH [-f env.yml] [--fix-cuda] [conda create arguments...]
        Build a new environment on node-local disk and pack it straight into
        an image; nothing is extracted on the shared filesystem.
  $PROG install|update|remove NAME [conda arguments...]
        Change a packed environment: rebuilt on node-local disk, repacked and
        swapped in. Commands already running keep the old image.
  $PROG edit NAME [-- command...]
        Make the environment writable on node-local disk for a shell, or one
        command, then repack what changed. Use it for pip, or to batch changes.
  $PROG unpack <name>
        Restore the environment from its image. The way back out.

  $PROG mount <name> / umount <name> [--force]
        Mount the image at the environment's original path, for this node.
        umount refuses while processes or activated shells are using it.
  $PROG exec <name> -- <cmd>...
        Run one command with the image mounted in a private namespace.
  $PROG shell <name>
        An interactive shell in the environment.
  eval "\$($PROG activate <name>)"   /   eval "\$($PROG deactivate)"
        Put the environment on PATH in the current shell, mounting it if needed.

  $PROG delete <name> [-y]
        Delete a packed environment: its image, its mountpoint and its entry.

  $PROG list / verify <name> / forget <name> [--force] / doctor

Environment:
  HAVERSACK_IMAGES     where images go (default: <env-parent>/.haversack)
  HAVERSACK_CONDA      conda, mamba or micromamba to build with (default: first on PATH)
  HAVERSACK_BUILD_DIR  node-local directory for builds (default: \$TMPDIR, else /tmp)
  HAVERSACK_PKGS_DIR   package cache for builds (default: a fresh one inside the build)
  HAVERSACK_REGISTRY   index, locks and activation records
                          (default: ~/.local/share/haversack)
EOF
}

# Paths to remove when this command exits, however it exits: temporary images,
# build directories, restore directories.  Once one has been moved into place
# its path is gone and there is nothing to remove.  CLEANUP_EMPTY holds
# directories this command created that should go only if still empty.
CLEANUP=()
CLEANUP_EMPTY=()
cleanup() {
    local p
    # Every step tolerates failure: under set -e, a failure in an exit trap
    # replaces the command's own exit status.
    for p in "${CLEANUP[@]}"; do
        # A build can contain read-only directories.
        if [[ -e $p ]]; then chmod -R u+w -- "$p" 2>/dev/null || true; rm -rf -- "$p" || true; fi
    done
    # Directories that were filled in on success are expected to stay.
    for p in "${CLEANUP_EMPTY[@]}"; do rmdir -- "$p" 2>/dev/null || true; done
    return 0
}
trap cleanup EXIT
trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP

case ${1:-} in
    pack)       shift; cmd_pack "$@" ;;
    create)     shift; cmd_create "$@" ;;
    install|update|remove) cmd_rebuild "$@" ;;
    edit)       shift; cmd_edit "$@" ;;
    unpack)     shift; cmd_unpack "$@" ;;
    mount)      shift; cmd_mount "$@" ;;
    umount|unmount) shift; cmd_umount "$@" ;;
    exec)       shift; cmd_exec "$@" ;;
    shell)      shift; cmd_shell "$@" ;;
    activate)   shift; cmd_activate "$@" ;;
    deactivate) shift; cmd_deactivate "$@" ;;
    list|ls)    shift; cmd_list "$@" ;;
    verify)     shift; cmd_verify "$@" ;;
    delete)     shift; cmd_delete "$@" ;;
    forget)     shift; cmd_forget "$@" ;;
    doctor)     shift; cmd_doctor "$@" ;;
    _ref)       shift; cmd__ref "$@" ;;
    -V|--version) echo "$PROG $VERSION" ;;
    ""|-h|--help) usage ;;
    *)          die "unknown command '$1' (try: $PROG --help)" ;;
esac
